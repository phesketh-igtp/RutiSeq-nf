params {
    config_profile_description = 'IGTP Institut Germans Trias i Pujol (IGTP) cluster profile'
    config_profile_contact = 'Poppy J Hesketh Best (phesketh@igtp.cat)'
}

process {
    executor = 'sge'
    queue = 'd10imppcv3'
    errorStrategy = 'retry'
    maxRetries = 2
    jobName = { "nf-${task.process.tokenize(':')[-1]}.${task.id}" }

    // Default configuration
    cpus = 4
    memory = '16 GB'
    time = '2h'
    clusterOptions = { "-l h=sge-exec-12 -pe smp ${task.cpus}" }

    // High memory configuration
    withLabel: 'highmem' {
        memory = '64 GB'
        cpus = 8
        time = '4h'
        clusterOptions = { "-l h=sge-exec-12 -pe smp ${task.cpus} -l mem_free=${task.memory.toGiga()}G,h_vmem=${task.memory.toGiga()}G" }
    }

    // Low memory configuration
    withLabel: 'lowmem' {
        memory = '4 GB'
        cpus = 2
        time = '1h'
        clusterOptions = { "-l h=sge-exec-12 -pe smp ${task.cpus} -l mem_free=${task.memory.toGiga()}G,h_vmem=${task.memory.toGiga()}G" }
    }
}

executor {
    name = 'sge'
    queueSize = 100
    pollInterval = '30 sec'
    qsubOptions = '-S /bin/bash'
}

// Conda configuration
conda {
    enabled = true
    useMamba = true
    cacheDir = '/imppc/labs/emlab/phesketh/miniconda3/envs'
}

singularity.enabled = false
docker.enabled = false

// Override Nextflow's default SGE settings
sge {
    queueSize = 100
    pollInterval = '30 sec'
    qsubOptions = '-S /bin/bash'
    clusterOptions = { "-l h=sge-exec-12 -pe smp ${task.cpus}" }
}

workflow {
    output {
        enabled = true
        overwrite = true
    }
}