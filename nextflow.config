// Enable DSL2
nextflow.enable.dsl = 2

// Create timestamp definition
def timestamp = new java.util.Date().format("yyyy-MM-dd_HH-mm-ss")

params {
    // Output directory
        outdir                  = "/imppc/labs/emlab/share/TBSEQ/RutiSeq"
        runID                   = null
        workDir                 = "."
        cpus                    = 6

    // Database path
        kraken_db_path          = "/imppc/labs/emlab/share/bbdd/kraken2/kraken2-microbial-fatfree"
        tbprofiler_tbdb         = "${projectDir}/db/tb-profiler_db/tbdb"
        tbprofiler_who          = "${projectDir}/db/tb-profiler_db/who"
        mtbseq_gene_annotations = "${projectDir}/db/H37Rv_db/M._tuberculosis_H37Rv_2015-11-13_genes.txt"
        r_script_dir            = "${projectDir}/bin/R"
        script_dir              = "${projectDir}/bin"
        mtbc_ancestor_path      = "${projectDir}/db/MTBc_ancestral_sequence/MTB_ancestor_reference.pos.gz"
        snpeff_ref_genome       = "Mycobacterium_tuberculosis_h37rv"
        // this bbdd will be populated with SNP barcodes of YOUR clusters BUT only if they are generated through the workflow
        rutiseq_db              = "${projectDir}/db/RutiSeq-db"

    // Lineages for clustering (this is defined by the TB-Profiler lineage classification)
    /// The purpose of this is to break up the genomes into smaller more computationally manageble using for analysis
    /// the list will depend entirely on what the bulk of your data is, in this case it is presumed that lineage4
    /// will be the most abundant, thus we take a level 2 sub-lineage classification to perform the clustering at
    /// but not for other lineages as they all have <800 genomes. Once a lineage had around that amount, you want to take the 
    /// next sub-lineage level (given as a tuple)

        lineage_pairwise = [
                            "La1", "La2", "La3", "lineage1", "lineage2", "lineage3", "lineage5", "lineage6",
                            "lineage4.1", "lineage4.2", "lineage4.3", "lineage4.4", "lineage4.5", "lineage4.6", 
                            "lineage4.7", "lineage4.8", "lineage4.9"
                            ]

        lineage_pairwise_main   = [ "La1", "La2", "La3", "lineage1", "lineage2", "lineage3", "lineage4", "lineage5",
                                    "lineage6" ]

        lineage_pairwise_sub    = [ "lineage4.1", "lineage4.2", "lineage4.3", "lineage4.4", "lineage4.5", "lineage4.6", 
                                    "lineage4.7", "lineage4.8", "lineage4.9" ]

    // MTBseq default values
        mtbseq_min_cov          = 0.95 // minimum breadth coverage as calculated by MTBseq for pairwise analysis
        mtbseq_min_depth        = 50 // minimum depth coverage as calculated by MTBseq for pairwise analysis
        mtbseq_min_reads        = 500000 
        mtbseq_minbqual         = 20
        mtbseq_mincovf          = 4
        mtbseq_mincovr          = 4
        mtbseq_minphred20       = 4
        mtbseq_minfreq          = 75
        mtbseq_unambig          = 95
        mtbseq_window           = 10
        mtbseq_snp_distance     = ["5", "10", "15"] // a tuple of all the distances to compared

        // ONT parameters (WIP)
        ont_mtbseq_min_cov      = 0.95 // minimum breadth coverage as calculated by MTBseq for pairwise analysis
        ont_mtbseq_min_depth    = 30 // minimum depth coverage as calculated by MTBseq for pairwise analysis
        ont_mtbseq_min_reads    = 10000 

    // IQ-Tree bootstraps
        iqtree_bootstraps       = 1000
        iqtree_model            = 'GTR+G4'

    // Conda paths (built from yml files):
        envs_dir                = "${projectDir}/envs/conda"
        taxonomy_env            = "${projectDir}/envs/conda/taxonomy_env.yml"
        bcftools_env            = "${projectDir}/envs/conda/bcftools_env.yml"
        mtbseq_env              = "${projectDir}/envs/conda/mtbseq_env.yml"
        tbprofiler_env          = "${projectDir}/envs/conda/tbprofiler_env.yml"
        r_stats_env             = "${projectDir}/envs/conda/r-stats_stats_env.yml"
        snp_profiling_env       = "${projectDir}/envs/conda/snp_profiling_env.yml"
        phylogeny_env           = "${projectDir}/envs/conda/r-phylogeny_env.yml"

    // Docker images (from seqera container builder):
        docker_tax           = "community.wave.seqera.io/library/kaiju_seqkit:9f6e07b33a94e6ad" //https://wave.seqera.io/view/builds/bd-9f6e07b33a94e6ad_1
        docker_mtbseq        = "community.wave.seqera.io/library/mtbseq:1.1.0--3ef3983aae64199d" //https://wave.seqera.io/view/builds/bd-3ef3983aae64199d_1
        docker_tbprofiler    = "community.wave.seqera.io/library/tb-profiler:6.5.0--663b287ceab908ed" //https://wave.seqera.io/view/builds/bd-663b287ceab908ed_1
        docker_snp_profiling = "community.wave.seqera.io/library/bcftools_seqkit_snpeff_varscan_vcftools:9b3d3a30bc88f200" //https://wave.seqera.io/view/builds/bd-9b3d3a30bc88f200_1
        docker_phylogeny     = "community.wave.seqera.io/library/iqtree_mafft_seqkit_snp-sites_treetime:7fffaf73832e61c8" //https://wave.seqera.io/view/builds/bd-7fffaf73832e61c8_1
        docker_r_stats       = "community.wave.seqera.io/library/bioconductor-ggtree_bioconductor-treeio_r-ape_r-argparse_pruned:24c45088dcaedc24" //https://wave.seqera.io/view/builds/bd-24c45088dcaedc24_1

    // Singularity images (from seqera container builder):
        singularity_tax           = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/c2/c21eafb6f3c8b7b61d6221412e8fd8e0f7ac78e5087c4be5aa7fb785a0502339/data" //https://wave.seqera.io/view/builds/bd-40ff2dbf082cfb59_1
        singularity_mtbseq        = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/ce/ce098dd570838fdcb0eb401b3afe4ebf4bc88d1038768ec18b3f970deb28c313/data" //https://wave.seqera.io/view/builds/bd-d0a0774ca038b4d3_1
        singularity_tbprofiler    = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/25/25b96ccbdf8a2f57ec1b37a36a72f9f880cc4cd3da93a5e54147b8a57fbda0a6/data" //https://wave.seqera.io/view/builds/bd-078c649aa2593744_1
        singularity_snp_profiling = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/4c/4cefdac4d051ae430521a0bd4c0299968677afd830e3c2c14a34282ebe3c5256/data" //https://wave.seqera.io/view/builds/bd-96c4708c08a7a7c2_1
        singularity_phylogeny     = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/00/00310d9d2bbbf70c7e5b4a9427ceb2624a728ec129cfe9519a4b1335c7769f79/data" //https://wave.seqera.io/view/builds/bd-6611a027a76ae000_1
        singularity_r_stats       = "" //

    // Apptainer images
        apptainer_tax           = "docker://community.wave.seqera.io/library/kaiju_seqkit:9f6e07b33a94e6ad" //https://wave.seqera.io/view/builds/bd-9f6e07b33a94e6ad_1
        apptainer_mtbseq        = "docker://community.wave.seqera.io/library/mtbseq:1.1.0--3ef3983aae64199d" //https://wave.seqera.io/view/builds/bd-3ef3983aae64199d_1
        apptainer_tbprofiler    = "docker://community.wave.seqera.io/library/tb-profiler:6.5.0--663b287ceab908ed" //https://wave.seqera.io/view/builds/bd-663b287ceab908ed_1
        apptainer_snp_profiling = "docker://community.wave.seqera.io/library/bcftools_seqkit_snpeff_varscan_vcftools:9b3d3a30bc88f200" //https://wave.seqera.io/view/builds/bd-9b3d3a30bc88f200_1
        apptainer_phylogeny     = "docker://community.wave.seqera.io/library/iqtree_mafft_seqkit_snp-sites_treetime:7fffaf73832e61c8" //https://wave.seqera.io/view/builds/bd-7fffaf73832e61c8_1
        apptainer_r_stats       = "docker://community.wave.seqera.io/library/bioconductor-ggtree_bioconductor-treeio_r-ape_r-argparse_pruned:24c45088dcaedc24" //https://wave.seqera.io/view/builds/bd-24c45088dcaedc24_1

    // Error strategy
    process.errorStrategy = 'finish'

    }

/* 
    PROFILES:
        Personal profile for running on the IGTP computing cluster
        nextflow run main.nf [···] -profile igtp,singularity_on -ansi-log false
*/

profiles {
    conda_on {
            conda.enabled       = true
            conda.useMamba      = true
            conda.createTimeout = '1 h'
            conda.cacheDir      = "${projectDir}/nf-conda/cache/"
    }

    apptainer_on {
            apptainer.enabled       = true
            apptainer.autoMounts    = true
            apptainer.cacheDir      = "${projectDir}/nf-apptainer/cache/"

    }

    singularity_on {
            singularity.enabled     = true
            singularity.autoMounts  = true
            singularity.cacheDir    = "${projectDir}/nf-singularity/cache/"
    }

    igtp {
        process {
            executor = 'sge'
            penv = 'smp'
            queue = 'd10imppcv3'
            clusterOptions = '-S /bin/bash' // '-V' does seem to solve a singularity issue (unsure)
            beforeScript = 'source /imppc/labs/emlab/phesketh/miniforge3/etc/profile.d/conda.sh'
            queueSize = 50
            //submitRateLimit = '10 sec'  // or '10/2min' for 10 jobs every 2 minutes

        /*
            MODULE RESOURCE ALLOCATIONS AND DEFINING ADDITIONAL ARGUMENTS
        */

            /*
                Workflow: Negative control
            */

                withName: INSPECT_BBDD {
                    cpus                        = 1
                    memory                      = 6.Gb
                    time                        = 5.min
                }

                withName: TBPROFILER_DB_UPDATE {
                    cpus                        = 2
                    memory                      = 8.GB
                    time                        = 1.hour
                }

                withName: CN_READ_TAXONOMY {
                    cpus                        = { Math.min(10 * task.attempt, 28) }
                    memory                      = 64.GB
                    time                        = 1.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 1
                    // Customised the running parameters by adding flag below:
                }

                withName: CN_TBPROFILER_TBDB {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 20.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args         = '' // tb-profiler args
                }

                withName: CN_MTBSEQ_SINGLE {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args         = '' // tb-profiler args
                }

            /*
                Workflow: SINGKE_WF()
            */

                withName: FILE_CHECK {
                    cpus                        = 1
                    memory                      = 6.Gb
                    time                        = 5.min
                }

                withName: MTBC_READ_QC {
                    cpus                        = { Math.min(4 + task.attempt, 28) }
                    memory                      = { 45.GB * task.attempt }
                    time                        = 1.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args_kaiju = '' // kaiju args
                    ext.additional_args_kaiju2table = '-r genus -m 1.0' // kaiju2table args
                }

                withName: TBPROFILER_PROFILE_TBDB {
                    cpus                        = { Math.min(4 + task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 20.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args         = '' // tb-profiler args
                }

                withName: TBPROFILER_PROFILE_WHO {
                    cpus                        = { Math.min(4 + task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 20.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args = '' // tb-profiler args
                }

                withName: MTBSEQ_SINGLE {
                    cpus                        = { Math.min(4 * task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 1.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                                            // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
                    ext.additional_args         = ''
                }

                withName: SNP_PROFILING_SINGLE {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 4.GB * task.attempt }
                    time                        = 1.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args_varscan = '--min-coverage 20 --min-reads2 20 --min-avg-qual 20' // varscan args
                }

                withName: SNP_ANNOTATING_SINGLE {
                    cpus                        = { Math.min(1 * task.attempt, 28) }
                    memory                      = { 4.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_str_snpeff   = '-v -hgvs1LetterAa -noStats -no-downstream -no-intergenic -no-intron -no-upstream -noLof '
                    //ext.additional_args_filt_snps = ['PE/PPE/PGRS', 'maturase', 'phage', 'mobile','13E12 repeat family protein']
                }

            /*
                Workflow: PAIRWISE_WF()
            */

                withName: TBPROFILER_COMPILE_TBDB {
                    cpus                        = { Math.min(1 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 10.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args         = '' // tb-profiler args
                }
                withName: TBPROFILER_COMPILE_WHO {
                    cpus                        = { Math.min(1 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 10.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args = '' // tb-profiler args
                }

                withName: MTBSEQ_STATS_COMPILE {
                    cpus                        = { Math.min(1 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 20.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args         = '' // tb-profiler args
                }

                withName: COMPILE_SEQUENCING_STATS {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 20.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args = '' // tb-profiler args
                }

                withName: MTBSEQ_LINEAGE_JOINT_AMEND {
                    cpus                        = { Math.min(8 * task.attempt, 28) }
                    memory                      = 45.GB
                    time                        = 24.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                                            // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
                    ext.additional_args         = ''
                    window                      = 10
                }

                withName: MTBSEQ_LINEAGE_GROUP {
                    cpus                        = { Math.min(6 * task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 24.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                                            // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
                    ext.additional_args         = ''
                }

                withName: CONCATENATED_VARIABLE_REGION_PHYLOGENY {
                    cpus                        = { Math.min(6 * task.attempt, 28) }
                    memory                      = { 16.GB * task.attempt }
                    time                        = 12.hour
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                    // Customised the running parameters by adding flag below:
                    ext.additional_args         = '' // tb-profiler args
                    bootstraps                  = 1000
                }

                withName: CONCATENATE_CLUSTERS {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 6.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

                withName: PROCESS_CLUSTERS {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 6.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

            /*
                Workflow: SUMMARY_WF()
            */

                withName: PLOT_MAIN_PHYLOGENY {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

                withName: GENERATE_SUMMARY_REPORT {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

                withName: PREPARE_NEXUS_PATHS {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.attempt <= 3 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

                withName: GENERATE_NEXUS {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.attempt <= 3 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

                withName: TABULATE_VARIANT_SITES {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.attempt <= 3 ? 'retry' : 'finish' }
                    maxRetries                  = 3
                }

                withName: CONCATENATED_VARIANT_FILES {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.attempt <= 3 ? 'retry' : 'ignore' }
                    maxRetries                  = 3
                }

                withName: GENERATE_TIMETREES {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
                    maxRetries                  = 3
                }

                withName: PLOT_TIMETREES {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.attempt <= 3 ? 'retry' : 'ignore' }
                    maxRetries                  = 3
                }

                withName: GENERATE_NEXUS_W_MRCA {
                    cpus                        = { Math.min(2 * task.attempt, 28) }
                    memory                      = { 8.GB * task.attempt }
                    time                        = 30.min
                    errorStrategy               = { task.attempt <= 3 ? 'retry' : 'ignore' }
                    maxRetries                  = 3
                }
            }
        }
    }

/*
    LOGGING:
*/

    report {
        enabled = true
        file = "${params.outdir}/pipeline_info/execution_report_${timestamp}.html"
        showSkipped = false
        showTaskCacheInfo = false
        showTaskResources = true
        showTaskResourcesPercentage = true
    }

    timeline {
        enabled     = true
        file        = "${params.outdir}/pipeline_info/execution_timeline_${timestamp}_${params.runID}.html"
    }

    trace {
        enabled     = true
        file        = "${params.outdir}/pipeline_info/execution_trace_${timestamp}_${params.runID}.tsv"
        fields      = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
    }

    dag {
        enabled     = true
        file        = "${params.outdir}/pipeline_info/pipeline_dag_${timestamp}_${params.runID}.png"
        file        = "${params.outdir}/pipeline_info/pipeline_dag_${timestamp}_${params.runID}.mmd"
        direction   = 'TB'
    }

    manifest {
        name        = 'RutiSeq-nf'
        author      = 'Poppy J. Hesketh Best'
        homePage    = 'https://github.com/phesketh-igtp/TBSEQ.cat-nf'
        description = 'Mapping, variant calling and genomic clustering for the ongoing monitoring of MTB outbreaks in Catalunya'
        mainScript  = 'main.nf'
        nextflowVersion = '24.10.2'
        version     = '1.0.0 [pre_release]'
    }