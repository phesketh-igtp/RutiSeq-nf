//    overwrite = true
//}

//dag {
//    enabled = true
//    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
//    overwrite = true
//}

// Manifest
manifest {
    name = 'RutiSeq-nf'
    author = 'Poppy J Hesketh Best'
    homePage = 'https://github.com/phesketh-igtp/TBSEQ.cat-nf'
    description = 'Mapping, variant calling and genomic clustering for the ongoining monitoring of MTB outbreaks in Catalunya'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.3'
    version = '1.0.0'
}