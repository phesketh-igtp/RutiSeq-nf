// Enable DSL2
nextflow.enable.dsl = 2

// Define parameters
params {

    // Default values here
    outdir = 'RutiSeq'
    samplesheet = 'RutiSeq.samples.csv'
    tbprof_threads = 2
    tbprof_ram = 4
    mtbseq_threads = 4

}

// Conda configuration
conda {
    enabled = false
    useMamba = false
}

// Singularity configuration
singularity {
    enabled = true
    autoMounts = true
    runOptions = '--privileged'
}

// Process-specific configurations
process {
    cpus = 1
    memory = '2 GB'
    
    withName: 'TBPROFILER_PROFILE_WHO' {
        cpus = params.tbprof_threads
        memory = "${params.tbprof_ram} GB"
        container = 'community.wave.seqera.io/library/tb-profiler:6.3.0--35b5c369eb6e0d52'
    }
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }
}

// Reporting configuration
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

// Function to ensure parameter has a trailing slash
def hasTrailingSlash = { it?.endsWith('/') ? it : "${it}/" }

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Manifest
manifest {
    name = 'RutiSeq-nf'
    author = 'Poppy J Hesketh Best'
    homePage = 'https://github.com/phesketh-igtp/TBSEQ.cat-nf'
    description = 'Your pipeline description'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.3'
    version = '1.0.0'
}

