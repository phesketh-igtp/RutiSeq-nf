// Enable DSL2
nextflow.enable.dsl = 2

// Conda configuration
conda {
    enabled = true
    useMamba = true
}

// Singularity configuration
singularity {
    enabled = true
    autoMounts = true
}

// Default parameters
params {
    // Pipeline parameters
    tbprof_threads = 4
    tbprof_ram = 8

    // Add other pipeline-specific parameters here
    // For example:
    // outdir = 'results'
    // input = 'data/*.fastq.gz'
}

// Process-specific configurations
process {
    // Default process configurations
    cpus = 1
    memory = '2 GB'
    
    withName: 'TBPROFILER_PROFILE_WHO' {
        cpus = params.tbprof_threads
        memory = "${params.tbprof_ram} GB"
        container = 'community.wave.seqera.io/library/tb-profiler:6.3.0--35b5c369eb6e0d52'
    }

    // Add configurations for other processes here
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }
    
    // Add other profiles as needed, e.g., for different execution environments
    // docker {
    //     docker.enabled = true
    // }
    
    // slurm {
    //     process.executor = 'slurm'
    // }
}

// Manifest
manifest {
    name = 'Your Pipeline Name'
    author = 'Your Name'
    homePage = 'https://github.com/yourusername/your-repo'
    description = 'Your pipeline description'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.10.3'
    version = '1.0.0'
}

// Enable reporting
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Function to ensure parameter has a trailing slash
def hasTrailingSlash = { it?.endsWith('/') ? it : "${it}/" }

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']