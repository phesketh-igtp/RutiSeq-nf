// Enable DSL2
nextflow.enable.dsl = 2

params {
    // Other existing parameters...
    
    // Database path
    kaiju = "/imppc/labs/emlab/share/bbdd/kaijudb/nr"

    }

// Preform work directory cleanup after a successful run (not recommended during dev)
//cleanup = true

// Profiles for resource, env, container management
process {
    executor            = 'sge'
    penv                = 'smp'
    queue               = 'd10imppcv3'
    clusterOptions      = { "-S /bin/bash -V -j y -l h_vmem=${task.memory.toGiga()}G" }
    queueSize           = 30
    submitRateLimit     = '15 sec'
}

profiles {

    apptainer_on {
        apptainer.enabled = true
    }

    conda_on {
        conda.enabled = true
    }

    singularity_on {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = '/imppc/labs/emlab/phesketh/.singularity/'
    }

    igtp {

        beforeScript = 'conda activate base'

        process {

            // Specific resources

            withName: MTBC_READ_QC{
                cpus = { Math.min(16 * task.attempt, 24) }
                memory = { 24.GB * task.attempt }
                time = 1.hour
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
                }

            withName: MTBSEQ_SINGLE{
                cpus = { Math.min(4 * task.attempt, 8) }
                memory = { 8.GB * task.attempt }
                time = 40.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
                }

            withName: TBPROFILER_DB_UPDATE{
                cpus = { Math.min(1 * task.attempt, 8) }
                memory = { 2.GB * task.attempt }
                time =  30.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
            }

            withName: TBPROFILER_PROFILE_TBDB{
                cpus = { Math.min(1 * task.attempt, 8) }
                memory = { 2.GB * task.attempt }
                time =  30.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
            }

            withName: TBPROFILER_PROFILE_WHO{
                cpus = { Math.min(1 * task.attempt, 8) }
                memory = { 2.GB * task.attempt }
                time =  30.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
            }

        }

        executor {
            
        }
    } 
}

