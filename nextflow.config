// Enable DSL2
nextflow.enable.dsl = 2

params {
    // Other existing parameters...
    
    // Database path
    kaiju = "/imppc/labs/emlab/share/bbdd/kaijudb/nr"

    }

// Profiles for resource, env, container management

profiles {
    apptainer_on {
        apptainer.enabled = true
    }

    conda_on {
        conda.enabled = true
        conda.useMamba = true
    }

    singularity_on {
        singularity.enabled = true
        singularity.cacheDir = '/imppc/labs/emlab/phesketh/.singularity/'
    }

    docker {
        docker.enabled = true
    }

    local {
        process.executor = 'local'
        conda.enabled = true
        conda.useMamba = true
        process {
            cpus = 8
            memory = 30.GB
        }
    }
    
    igtp {

        conda.enabled = true
        conda.useMamba = true
        // This is the important part:
        ///beforeScript = '''
        ///    export PATH="/imppc/labs/emlab/phesketh/miniconda3/bin:$PATH"
        ///    source "/imppc/labs/emlab/phesketh/miniconda3/etc/profile.d/conda.sh"
        ///    conda activate base
        /// '''
        beforeScript = 'conda activate base'

        process {

            // Default resources for all processes
            executor = 'sge'
            penv = 'smp'
            queue='d10imppcv3'

            //clusterOptions = {             // set the random host allocation to one of these three hosts
            //            def hosts = ['sge-exec-12', 'sge-exec-13', 'sge-exec-14']
            //            def selectedHost = hosts[new Random().nextInt(hosts.size())]
            //            "-l h=${selectedHost}"
            //                }

            cpus = 8
            memory = 4.GB
            time = '1h'


            
            // Specific resources

            withName: MTBC_READ_QC{
                cpus = { Math.min(16 * task.attempt, 24) }
                memory = { 24.GB * task.attempt }
                time = 1.hour
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
                }

            withName: MTBSEQ_SINGLE{
                cpus = { Math.min(4 * task.attempt, 8) }
                memory = { 8.GB * task.attempt }
                time = 40.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
                }

            withName: TBPROFILER_DB_UPDATE{
                cpus = { Math.min(1 * task.attempt, 8) }
                memory = { 2.GB * task.attempt }
                time =  30.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
            }

            withName: TBPROFILER_PROFILE_TBDB{
                cpus = { Math.min(1 * task.attempt, 8) }
                memory = { 2.GB * task.attempt }
                time =  30.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
            }

            withName: TBPROFILER_PROFILE_WHO{
                cpus = { Math.min(1 * task.attempt, 8) }
                memory = { 2.GB * task.attempt }
                time =  30.min
                    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
                    maxRetries = 3
            }

        }

        executor {
            name = 'sge'
            queueSize = 30
            submitRateLimit = '15 sec'
        }
    } 
}

