// Enable DSL2
nextflow.enable.dsl = 2

// Define parameters
params {

    // Default values here
    outdir = 'RutiSeq'
    samplesheet = 'RutiSeq.samples.csv'
    tbprof_threads = 2
    tbprof_ram = 3
    mtbseq_threads = 2

}

// Profiles for resource, env, container management
profiles {
    apptainer_on {
        apptainer.enabled = true
        
    }

    conda_on {
            conda.enabled = true
            conda.useMamba = true
    }

    local {
        process.executor = 'local'
        conda.enabled = true
        conda.useMamba = true
        process {
            cpus = 8
            memory = 30.GB
        }
    }
    
    igtp {
        conda.enabled = true
        conda.useMamba = true
        beforeScript = 'source /imppc/labs/emlab/phesketh/miniconda3/bin/activate'
        
        process {

            // Default resources for all processes
            executor = 'sge'
            queue='d12imppc'
            clusterOptions = { "-l hostname=sge-exec-12|sge-exec-13|sge-exec-14" }
            cpus = 1
            memory = 4.GB
            time = '1h'
            
            // Specific resources
            withName: 'MTBSEQ_SINGLE' {
                cpus = 8
                memory = 16.GB
                time = '1h'
            }

            withName: 'TBPROFILER_PROFILE_TBDB' {
                cpus = 4
                memory = 8.GB
                time = '1h'
            }

            withName: 'TBPROFILER_PROFILE_WHO' {
                cpus = 4
                memory = 8.GB
                time = '1h'
            }

        }

        executor {
            name = 'sge'
            queueSize = 100
            submitRateLimit = '10 sec'
        }
    } 
}

// Singularity configuration
singularity {
    enabled = false
    autoMounts = false
    runOptions = '--privileged'
}

