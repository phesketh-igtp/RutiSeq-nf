/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RutiSeq-nf Nextflow config file - SGE Resource Allocation
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process-specific resource allocations for SGE executor
----------------------------------------------------------------------------------------
*/

    /*
        MODULE RESOURCE ALLOCATIONS AND DEFINING ADDITIONAL ARGUMENTS
    */


process {

    /*
        Workflow: VERSION_CONTRL()
    */
    withName: MTBSEQ_ENV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        }
    withName: READQC_EV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        // Customised the running parameters by adding flag below:
        }
    withName: TBPROFILER_ENV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        // Customised the running parameters by adding flag below:
        }
    withName: PHYLOGENY_ENV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        // Customised the running parameters by adding flag below:
        }
    withName: R_STATS_ENV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        // Customised the running parameters by adding flag below:
        }
    withName: R_PHYLOGENY_ENV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        // Customised the running parameters by adding flag below:
        }
    withName: SNIPPY_ENV {
        cpus                        = 1
        memory                      = 1
        time                        = 10.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 5
        // Customised the running parameters by adding flag below:
        }

    /*
        Workflow: CONTROL_WF()
    */

    withName: SYLPH_CLASSIFICATION {
        cpus                        = { Math.min( 8 * task.attempt, 24 ) }
        memory                      = { 48.GB * 2 }
        time                        = 6.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 2
        // Customised the running parameters by adding flag below:
        }

    withName: SKA_PROFILING {
        cpus                        = 8
        memory                      = 24.GB
        time                        = 12.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
        maxRetries                  = 1
        // Customised the running parameters by adding flag below:
    }

    withName: READS_STATS {
        cpus                        = 4
        memory                      = 16.GB
        time                        = 2.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
    }

    withName: MULTIQC {
        cpus                        = { Math.min( 8 * task.attempt, 24 ) }
        memory                      = 16.GB
        time                        = 5.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
    }

    withName: READ_TAXONOMY_QC_REPORT {
        cpus                        = 1
        memory                      = 8.GB
        time                        = 20.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
    }

    /*
        Workflow: SINGLE_WF()
    */

    withName: FILE_CHECK {
        cpus                        = 1
        memory                      = 6.Gb
        time                        = 5.min
        }

    withName: ADAPTORS_AND_DOWNSAMPLING {
        cpus                        = { Math.min( 0 + task.attempt, 4 ) }
        memory                      = { 6.GB * task.attempt }
        time                        = 1.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        }

    withName: TBPROFILER_PROFILE {
        cpus                        = { Math.min( 0 + task.attempt, 4 ) }
        memory                      = { 8.GB * task.attempt }
        time                        = 4.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        ext.additional_args         = '' // tb-profiler args
        }

    withName: MTBSEQ_SINGLE {
        cpus                        = { Math.min( 2 + task.attempt, 8 ) }
        memory                      = { 16.GB * task.attempt }
        time                        = 4.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: SNIPPY_SINGLE {
        cpus                        = { Math.min( 1 + task.attempt, 28 ) }
        memory                      = { 8.GB * task.attempt }
        time                        = 1.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        ext.additional_args_varscan = '--min-coverage 20 --min-reads2 20 --min-avg-qual 20' // varscan args
        }

    /*
        Workflow: PAIRWISE_WF()
    */

    withName: TBPROFILER_COMPILE {
        cpus                        = { Math.min( 1 + task.attempt, 28 ) }
        memory                      = { 8.GB * task.attempt }
        time                        = 30.min
        errorStrategy               = 'retry'
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        ext.additional_args         = '' // tb-profiler args
        }

    withName: MTBSEQ_STATS_COMPILE {
        cpus                        = { Math.min(1 + task.attempt, 28) }
        memory                      = { 8.GB * task.attempt }
        time                        = 30.min
        errorStrategy               = 'retry'
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        ext.additional_args         = '' // tb-profiler args
        }

    withName: COMPILE_SEQUENCING_STATS {
        cpus                        = { Math.min(2 + task.attempt, 28) }
        memory                      = { 8.GB * task.attempt }
        time                        = 30.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        ext.additional_args = '' // tb-profiler args
        }

    withName: SNIPPY_CORE {
        cpus                        = { Math.min(7 + task.attempt, 28) }
        memory                      = 32.GB
        time                        = 24.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
                                    // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: SNIPPY_LINEAGE_CORE {
        cpus                        = { Math.min(7 + task.attempt, 16) }
        memory                      = 32.GB
        time                        = 24.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 2
        // Customised the running parameters by adding flag below:
                                    // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: SNIPPY_LINEAGE_CORE_PHYLOGENY {
        cpus                        = { Math.min(5 + task.attempt, 12) }
        memory                      = 16.GB
        time                        = 24.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
                                    // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: SNIPPY_PHYLOGENY {
        cpus                        = { Math.min(7 + task.attempt, 28) }
        memory                      = 32.GB
        time                        = 24.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
                                    // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: MTBSEQ_LINEAGE_JOINT_AMEND {
        cpus                        = { Math.min(7 + task.attempt, 16) }
        memory                      = 62.GB
        time                        = 48.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 2
        // Customised the running parameters by adding flag below:
                                    // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: MTBSEQ_LINEAGE_GROUP {
        cpus                        = { Math.min(3 + task.attempt, 28) }
        memory                      = { 16.GB * task.attempt }
        time                        = 12.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        // MTBseq args - if have to ensure that ALL MTBSEQ related additional arguments are the same
        ext.additional_args         = ''
        }

    withName: SNP_PHYLOGENY {
        cpus                        = { Math.min(6 + task.attempt, 28) }
        memory                      = { 16.GB * task.attempt }
        time                        = 12.hour
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        // Customised the running parameters by adding flag below:
        ext.additional_args         = '' // tb-profiler args
        }

    withName: CONCATENATE_CLUSTERS {
        cpus                        = { Math.min(2 + task.attempt, 28) }
        memory                      = { 6.GB * task.attempt }
        time                        = 30.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        }

    /*
        Workflow: SUMMARY_WF()
    */

    withName: PLOT_MAIN_PHYLOGENY {
        cpus                        = { Math.min(2 + task.attempt, 28) }
        memory                      = { 16.GB * task.attempt }
        time                        = 1.h
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        }

    withName: GENERATE_SUMMARY_REPORT {
        cpus                        = { Math.min(2 + task.attempt, 28) }
        memory                      = { 8.GB * task.attempt }
        time                        = 30.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
        maxRetries                  = 3
        }

    withName: NEXUS_GEN {
        cpus                        = { Math.min(0 + task.attempt, 4) }
        memory                      = { 8.GB * task.attempt }
        time                        = 60.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
        maxRetries                  = 3
        }

    withName: DATA_DELIVERY {
        cpus                        = { Math.min(0 + task.attempt, 28) }
        memory                      = { 6.GB * task.attempt }
        time                        = 30.min
        errorStrategy               = { task.exitStatus in 137..140 ? 'retry' : 'ignore' }
        maxRetries                  = 3
    }
}